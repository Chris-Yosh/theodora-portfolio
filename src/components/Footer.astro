---
import { site } from '../data/site';
const l = site.links;
const socials = [['Malt', l.malt], ['LinkedIn', l.linkedin], ['Behance', l.behance], ['Vimeo', l.vimeo], ['Dribbble', l.dribbble]];
---
<footer id="contact" class="foot">
  <div class="wrap">
    <p class="label muted">Contact</p>
    <h2 class="big" data-lines>Racontons votre <em>prochaine</em> histoire.</h2>
    <a class="cta" href={l.malt} target="_blank" rel="noopener" data-cursor="Écrire">
      <span>Démarrer un projet sur Malt</span>
      <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M5 19 19 5M8 5h11v11" /></svg>
    </a>
    <div class="row">
      <ul>{socials.map(([n, h]) => <li><a class="ulink reverse" href={h} target="_blank" rel="noopener">{n}</a></li>)}</ul>
      <p class="muted">© {new Date().getFullYear()} {site.name} — Direction artistique & motion design, {site.city}</p>
    </div>
  </div>
</footer>
<style>
  .foot { margin-top: clamp(120px, 18vw, 260px); padding-block: clamp(64px, 10vw, 140px) 32px; background: var(--ink); color: var(--paper); }
  .big { margin-top: 24px; font-size: clamp(3.2rem, 11vw, 11.5rem); max-width: 12ch; }
  .big em { color: var(--pink); }
  .cta { display: inline-flex; align-items: center; gap: 18px; margin-top: clamp(40px, 6vw, 72px); padding: 22px 30px; border: 1px solid rgb(243 240 245 / 0.3); border-radius: 999px; font-size: 1.15rem; transition: background 0.6s var(--ease), color 0.6s var(--ease); }
  .cta:hover { background: var(--paper); color: var(--ink); }
  .cta svg { transition: transform 0.6s var(--ease); }
  .cta:hover svg { transform: rotate(45deg); }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20px; margin-top: clamp(80px, 12vw, 160px); padding-top: 24px; border-top: 1px solid rgb(243 240 245 / 0.18); font-size: 0.9rem; }
  .row ul { display: flex; flex-wrap: wrap; gap: 24px; list-style: none; margin: 0; padding: 0; }
  .row .muted { color: rgb(243 240 245 / 0.55); }
</style>
