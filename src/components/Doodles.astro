---
// Dessins au trait qui flottent (référence : Belle). Positions en % du conteneur parent (position: relative).
interface Props { set?: 'hero' | 'soft' }
const { set = 'hero' } = Astro.props;
const items = set === 'hero'
  ? [
      { k: 'star', x: 6, y: 18, s: 84, d: 0.2, c: 'var(--butter)' },
      { k: 'squiggle', x: 86, y: 12, s: 130, d: 0.35, c: 'none' },
      { k: 'flower', x: 90, y: 62, s: 110, d: 0.15, c: 'var(--pink)' },
      { k: 'eye', x: 4, y: 70, s: 100, d: 0.4, c: '#fff' },
      { k: 'heart', x: 46, y: 6, s: 56, d: 0.5, c: 'var(--peach)' },
      { k: 'spiral', x: 70, y: 88, s: 90, d: 0.25, c: 'none' },
    ]
  : [
      { k: 'flower', x: 3, y: 10, s: 90, d: 0.2, c: 'var(--sky)' },
      { k: 'star', x: 94, y: 70, s: 70, d: 0.3, c: 'var(--mint)' },
    ];
---
<div class="doodles" aria-hidden="true">
  {items.map((i) => (
    <svg class="doodle" data-float data-depth={i.d} style={`left:${i.x}%;top:${i.y}%;width:${i.s}px`} viewBox="0 0 100 100" fill={i.c} stroke="var(--ink)" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round">
      {i.k === 'star' && <path d="M50 8 L61 38 L93 40 L68 60 L77 92 L50 74 L23 92 L32 60 L7 40 L39 38 Z" />}
      {i.k === 'squiggle' && <path d="M6 60 C 16 20, 28 20, 36 54 S 56 90, 66 50 S 86 14, 94 44" fill="none" />}
      {i.k === 'flower' && (<g><circle cx="50" cy="22" r="17" /><circle cx="78" cy="42" r="17" /><circle cx="68" cy="74" r="17" /><circle cx="32" cy="74" r="17" /><circle cx="22" cy="42" r="17" /><circle cx="50" cy="52" r="11" fill="var(--butter)" /></g>)}
      {i.k === 'eye' && (<g><path d="M6 50 C 24 16, 76 16, 94 50 C 76 84, 24 84, 6 50 Z" /><circle cx="50" cy="50" r="15" fill="var(--ink)" /><circle cx="55" cy="45" r="4" fill="#fff" stroke="none" /></g>)}
      {i.k === 'heart' && <path d="M50 88 C 6 56, 14 14, 40 20 C 46 22, 50 28, 50 28 C 50 28, 54 22, 60 20 C 86 14, 94 56, 50 88 Z" />}
      {i.k === 'spiral' && <path d="M50 50 m0 -4 a4 4 0 1 1 -4 4 a10 10 0 1 1 10 10 a18 18 0 1 1 -18 -18 a26 26 0 1 1 26 26 a34 34 0 1 1 -34 -34" fill="none" />}
    </svg>
  ))}
</div>
<style>
  .doodles { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
  .doodle { position: absolute; height: auto; overflow: visible; }
</style>
