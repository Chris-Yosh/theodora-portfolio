---
const nav = [
  { href: '/#realisations', label: 'Réalisations' },
  { href: '/#index', label: 'Projets' },
  { href: '/#carnet', label: 'Carnet' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="top" data-header>
  <a class="name" href="/">Théodora Ballet</a>
  <p class="status label"><span class="dot" aria-hidden="true"></span>Disponible · Paris</p>
  <nav aria-label="Navigation principale">
    {nav.map((n) => <a class="ulink reverse" href={n.href}>{n.label}</a>)}
  </nav>
</header>
<style>
  .top { position: fixed; z-index: 60; inset: 0 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 18px var(--gutter); mix-blend-mode: difference; color: #fff; }
  .name { font: 1.6rem/1 var(--serif); letter-spacing: -0.01em; }
  .status { display: flex; align-items: center; gap: 8px; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #7dffa8; animation: pulse 2.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.25; } }
  nav { display: flex; justify-content: flex-end; gap: clamp(14px, 2.4vw, 32px); font-size: 0.92rem; }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr auto; } .status { display: none; } nav a:not(:last-child) { display: none; } }
</style>
