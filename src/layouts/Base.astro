---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
interface Props { title?: string; description?: string; image?: string }
const { title, description = site.tagline, image = '/images/projects/game-on/cover.webp' } = Astro.props;
const full = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}, ${site.city}`;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#f3f0f5" />
  </head>
  <body>
    <div class="curtain" aria-hidden="true" data-curtain></div>
    <Header />
    <main><slot /></main>
    <Footer />

    <div class="lb" data-lightbox hidden role="dialog" aria-modal="true" aria-label="Lecteur vidéo">
      <div class="lb-bg" data-lb-bg></div>
      <div class="lb-frame" data-lb-frame><img alt="" data-lb-poster /></div>
      <div class="lb-ui" data-lb-ui>
        <p class="lb-title"><span class="label" data-lb-meta></span><span data-lb-title></span></p>
        <a class="lb-ext ulink" data-lb-ext target="_blank" rel="noopener">Ouvrir sur Vimeo ↗</a>
        <button class="lb-close" data-lb-close type="button">Fermer <span aria-hidden="true">✕</span></button>
      </div>
    </div>

    <div class="cursor" aria-hidden="true" data-cursor-el><span data-cursor-label></span></div>
    <script>import '../scripts/motion';</script>
  </body>
</html>
<style is:global>
  .curtain { position: fixed; inset: 0; z-index: 100; background: var(--ink); transform-origin: top; pointer-events: none; animation: lift 1.1s cubic-bezier(0.76, 0, 0.24, 1) 0.15s forwards; }
  @keyframes lift { to { transform: scaleY(0); } }
  @media (prefers-reduced-motion: reduce) { .curtain { display: none; } }

  .lb { position: fixed; inset: 0; z-index: 80; }
  .lb-bg { position: absolute; inset: 0; background: rgb(20 18 26 / 0.94); backdrop-filter: blur(12px); }
  .lb-frame { position: absolute; overflow: hidden; border-radius: var(--radius); background: #000; transform-origin: 0 0; }
  .lb-frame img, .lb-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .lb-frame iframe { opacity: 0; transition: opacity 0.8s ease 0.3s; }
  .lb-frame iframe.on { opacity: 1; }
  .lb-ui { position: absolute; inset: auto 0 0; display: flex; align-items: end; justify-content: space-between; gap: 20px; padding: 22px var(--gutter); color: var(--paper); }
  .lb-title { display: grid; gap: 6px; font: 1.8rem/1 var(--serif); }
  .lb-title .label { font-family: var(--sans); opacity: 0.6; }
  .lb-ext { font-size: 0.9rem; margin-left: auto; }
  .lb-close { font-size: 0.9rem; display: inline-flex; gap: 10px; align-items: center; padding: 10px 18px; border: 1px solid rgb(243 240 245 / 0.35); border-radius: 999px; }
  .lb-close:hover { background: var(--paper); color: var(--ink); }

  .cursor { position: fixed; z-index: 90; top: 0; left: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: var(--ink); pointer-events: none; display: grid; place-items: center; mix-blend-mode: normal; opacity: 0; }
  .cursor span { font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--paper); opacity: 0; white-space: nowrap; }
  @media (hover: none) { .cursor { display: none; } }
</style>
